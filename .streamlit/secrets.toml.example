# Copy to .streamlit/secrets.toml (git-ignored) to run Ask Canary locally, or paste the same two lines
# into the app's Secrets box on share.streamlit.io. Placeholder values only: never commit a real key.
ANTHROPIC_API_KEY = "sk-ant-your-key-here"
ASK_ENABLED = "false"   # "true" turns the corner canary (Ask Canary chat) on; anything else leaves it off
