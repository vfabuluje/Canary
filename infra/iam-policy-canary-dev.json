{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Sid": "S3ReadWriteObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/*"
    },
    {
      "Sid": "S3DeleteScratchOnly",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/athena-results/*",
        "arn:aws:s3:::BUCKET_NAME/dbt/*"
      ]
    },
    {
      "Sid": "AthenaCanaryWorkgroupOnly",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:GetQueryRuntimeStatistics"
      ],
      "Resource": "arn:aws:athena:us-east-1:*:workgroup/canary"
    },
    {
      "Sid": "GlueCanaryDatabasesOnly",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetTableVersions",
        "glue:BatchDeleteTableVersion",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:*:catalog",
        "arn:aws:glue:us-east-1:*:database/canary_raw",
        "arn:aws:glue:us-east-1:*:database/canary_staging",
        "arn:aws:glue:us-east-1:*:database/canary_marts",
        "arn:aws:glue:us-east-1:*:table/canary_raw/*",
        "arn:aws:glue:us-east-1:*:table/canary_staging/*",
        "arn:aws:glue:us-east-1:*:table/canary_marts/*"
      ]
    }
  ]
}
